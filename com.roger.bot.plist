<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Roger paper-trading bot — launchd supervisor.
  DO NOT INSTALL until the fix branch is approved and merged: KeepAlive on
  unfixed code is a crash loop, not monitoring.

  Install (after approval):
    cp com.roger.bot.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.roger.bot.plist
  Remove:
    launchctl unload ~/Library/LaunchAgents/com.roger.bot.plist

  PAPER MODE ONLY: no - -live flag here, deliberately.  (Note: run_roger.sh
  as committed passes - -live; do not copy its command line.)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.roger.bot</string>

    <!--
      No WorkingDirectory and no Standard*Path on purpose: launchd performs
      those itself and is TCC-blocked from ~/Documents (EX_CONFIG/78).
      scripts/roger_launch.py does the chdir, log rotation and redirection
      from inside the interpreter, which does hold Full Disk Access.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/diegocrisafulli/Documents/expense/.venv/bin/python</string>
        <string>-u</string>
        <string>/Users/diegocrisafulli/Documents/expense/scripts/roger_launch.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Back off between crash restarts instead of spinning -->
    <key>ThrottleInterval</key>
    <integer>60</integer>
</dict>
</plist>
